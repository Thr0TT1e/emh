# ~/.config/containers/systemd/emh-frontend.container

[Unit]
Description=EMH Frontend (Nuxt ISR)
After=emh-backend.service

[Container]
Image=codeberg.org/thr0tt1e/emh-frontend:latest
ContainerName=emh-frontend
Network=emh-net.network
PublishPort=127.0.0.1:3000:3000

[Service]
Restart=always

[Install]
WantedBy=default.target
