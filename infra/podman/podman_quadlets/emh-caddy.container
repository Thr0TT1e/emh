# ~/.config/containers/systemd/emh-caddy.container

[Unit]
Description=Caddy Reverse Proxy
After=emh-frontend.service emh-backend.service
Requires=emh-frontend.service emh-backend.service

[Container]
Image=docker.io/caddy:2-alpine
ContainerName=emh-caddy
Volume=%h/emh/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy_data:/data
Volume=caddy_config:/config
Network=emh-net.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp

[Service]
Restart=always

[Install]
WantedBy=default.target
