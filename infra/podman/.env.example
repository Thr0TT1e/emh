# --------------------------------------------------
# Секция приложения emh_back
# --------------------------------------------------

# Опционально: переопределение пути к конфигу
CONFIG_PATH=config/config.yaml

# just jwt-secret -> openssl rand -hex 32
AUTH_JWT_SECRET=""
AUTH_API_KEYS=<сервисный_ключ_1>,<сервисный_ключ_2>

DB_HOST=postgres
DB_USER=<db_user>
DB_PASSWORD=<db_pass>
DB_NAME=<db_name>
DB_SSL_MODE=verify-full
# DB_SSL_CERT_FILE=/app/certs/server.pem
DATABASE_URL=postgres://<db_user>:<db_pass>@localhost:5432/<db_name>?sslmode=disable
# DB_URL=postgres://<db_user>:<db_pass>@localhost:5432/<db_name>?sslmode=verify-full&sslrootcert=/app/certs/server.pem

MINIO_ENDPOINT=http://localhost:4443
# MINIO_SSL_CERT=/app/certs/server.pem

# --------------------------------------------------
# Секция БД
# --------------------------------------------------
POSTGRES_DB=<db_name>
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_pass>
# POSTGRES_SSL_CERT_FILE=/var/lib/postgresql/certs/server.pem
# POSTGRES_SSL_KEY_FILE=/var/lib/postgresql/certs/server-key.pem
# POSTGRES_SSL_CA_FILE=/var/lib/postgresql/certs/ca.pem

# --------------------------------------------------
# Секция minio
# --------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_PUBLIC_BASE_URL=https://<domain>

# --------------------------------------------------
# Секция Contact / SMTP
# --------------------------------------------------

# Включить отправку email-уведомлений (true/false)
EMH_CONTACT_SMTP_ENABLED=false

# SMTP сервер (обязательно, если smtp_enabled=true)
EMH_CONTACT_SMTP_HOST=smtp.yandex.ru
EMH_CONTACT_SMTP_PORT=587
EMH_CONTACT_SMTP_USERNAME=
EMH_CONTACT_SMTP_PASSWORD=

# Адрес отправителя и получателя
EMH_CONTACT_SMTP_FROM_NAME=Вечная память героям
EMH_CONTACT_SMTP_FROM_EMAIL=no-reply@neverforgotten.ru
EMH_CONTACT_SMTP_TO=info@neverforgotten.ru

# Секрет для HMAC-хеширования IP (сгенерировать: openssl rand -hex 32)
EMH_CONTACT_IP_PEPPER=

# --- Тестовая инфраструктура ---
# URL тестовой PostgreSQL (запускается через `just test-db-up`)
# По умолчанию: postgres://emh_test:emh_test_secret@localhost:5444/emh_test_db?sslmode=disable
# TEST_DATABASE_URL=
