console.minio.neverforgotten.ru {
    basicauth {
        # Замените на реальный хеш: caddy hash-password --plaintext '<пароль>'
        # Логин/пароль НЕ должны совпадать с учётками MinIO/админки.
        admin $2a$14$REPLACE_WITH_REAL_BCRYPT_HASH_BEFORE_DEPLOY
    }

    reverse_proxy emh-minio:9001
}
